set -e
BK='/srv/bk'
f='db-1.dump'
case "$f" in /*) ;; *) f="$BK/$f" ;; esac
[ -n "$f" ] && [ -f "$f" ] || { echo "backup not found: $f" >&2; exit 1; }
umask 077
echo "restoring $f"
rts=$(date +%Y%m%d-%H%M%S)
hints=
restore_failed() {
  echo "restore failed, and the database may already be dropped." >&2
  if [ -n "$hints" ]; then echo "the data from before the restore is in a safety dump. Put it back with:$hints" >&2; fi
  exit 1
}
sudo -n docker exec -i 'app-postgres-1' pg_restore -l < "$f" >/dev/null || { echo "backup is not a readable dump, nothing was changed: $f" >&2; exit 1; }
if sudo -n docker exec 'app-postgres-1' psql -U 'app' -d 'appdb' -c 'select 1' >/dev/null 2>&1; then
  sudo -n docker exec 'app-postgres-1' pg_dump -U 'app' -Fc 'appdb' > "$BK/pre-restore-$rts.dump".partial || { rm -f "$BK/pre-restore-$rts.dump".partial; echo "safety dump failed, nothing was changed" >&2; exit 1; }
  mv "$BK/pre-restore-$rts.dump".partial "$BK/pre-restore-$rts.dump"
  echo "safety dump of the current database: $BK/pre-restore-$rts.dump"
  hints="$hints
  sudo -n docker exec -i 'app-postgres-1' dropdb -U 'app' --force --if-exists 'appdb' && sudo -n docker exec -i 'app-postgres-1' createdb -U 'app' 'appdb' && sudo -n docker exec -i 'app-postgres-1' pg_restore -U 'app' -d 'appdb' < \"$BK/pre-restore-$rts.dump\""
fi
sudo -n docker exec -i 'app-postgres-1' dropdb -U 'app' --force --if-exists 'appdb' || restore_failed
sudo -n docker exec -i 'app-postgres-1' createdb -U 'app' 'appdb' || restore_failed
sudo -n docker exec -i 'app-postgres-1' pg_restore -U 'app' -d 'appdb' < "$f" || restore_failed
echo "restored from $f"
